<div class="ol-root ol-scene-root {{#if isCombatMode}}{{#if isCombatVertical}}mode-combat-vertical{{else}}mode-combat-horizontal{{/if}}{{else}}mode-overview{{/if}}">
  <header class="ol-scene-header">
    <div class="ol-scene-heading" data-tooltip="{{localize 'OLATTACK.Scene.CardHintGM'}}">
      <h1>{{localize "OLATTACK.Scene.Title"}}</h1>
      <span class="ol-scene-scene-name" data-tooltip="{{sceneName}}">{{sceneName}}</span>
    </div>

    <div class="ol-scene-summary">
      <span class="ol-chip"><span>{{localize "OLATTACK.Scene.View"}}</span> <b>{{visibleSummary}}</b></span>
      {{#if isCombatMode}}
        <span class="ol-chip"><span>{{localize "OLATTACK.Scene.Combat"}}</span> <b>{{combatSummary}}</b></span>
        {{#if combatMeta.combatStarted}}<span class="ol-chip is-hot"><span>{{localize "OLATTACK.Scene.Round"}}</span> <b>{{combatMeta.combatRound}}</b></span>{{/if}}
        {{#if combatMeta.activeName}}<span class="ol-chip is-hot"><span>{{localize "OLATTACK.Scene.Turn"}}</span> <b>{{combatMeta.activeName}}</b></span>{{/if}}
      {{/if}}
      {{#if gmHandledName}}<span class="ol-chip"><span>GM</span> <b>{{gmHandledName}}</b></span>{{/if}}
    </div>

    <div class="ol-scene-toolbar">
      <div class="ol-segment" role="tablist" aria-label="{{localize 'OLATTACK.Scene.Mode'}}">
        {{#each modeButtons}}<button type="button" role="tab" class="ol-seg-btn {{#if active}}is-active{{/if}}" data-action="set-mode" data-mode="{{value}}" aria-selected="{{#if active}}true{{else}}false{{/if}}" data-tooltip="{{title}}">{{label}}</button>{{/each}}
      </div>
      <button type="button" class="ol-icon-btn" data-action="open-config" data-tooltip="{{localize 'OLATTACK.Scene.Configure'}}" aria-label="{{localize 'OLATTACK.Scene.Configure'}}"><i class="fa-solid fa-gear"></i></button>
      <button type="button" class="ol-icon-btn" data-action="refresh" data-tooltip="{{localize 'OLATTACK.Scene.Refresh'}}" aria-label="{{localize 'OLATTACK.Scene.Refresh'}}"><i class="fa-solid fa-rotate"></i></button>
    </div>
  </header>

  <details class="ol-ledger {{#unless damageLedger.active}}is-paused{{/unless}}" data-memoria="ledger" {{#if (lookup open "ledger")}}open{{/if}}>
    <summary>
      <span class="ol-ledger-title"><i class="fa-solid fa-burst"></i> {{localize "OLATTACK.Ledger.Title"}}</span>
      <span class="ol-ledger-state">{{#if damageLedger.active}}{{localize "OLATTACK.Ledger.On"}}{{else}}{{localize "OLATTACK.Ledger.Paused"}}{{/if}}</span>
      <span class="ol-chip {{#if damageLedger.pendingCount}}is-hot{{/if}}"><span>{{localize "OLATTACK.Ledger.Pending"}}</span> <b>{{damageLedger.pendingCount}}</b></span>
      <span class="ol-chip damage-total"><span>{{localize "OLATTACK.Ledger.Damage"}}</span> <b>{{damageLedger.pendingTotal}}</b></span>
      <button type="button" class="ol-btn-sm primary" data-action="apply-damage-ledger-all" {{#unless damageLedger.canApply}}disabled{{/unless}} data-tooltip="{{localize 'OLATTACK.Ledger.ApplyAllHint'}}"><i class="fa-solid fa-check-double"></i> {{localize "OLATTACK.Ledger.Apply"}} {{damageLedger.pendingTotal}}</button>
    </summary>

    <div class="ol-ledger-actions">
      <button type="button" class="ol-btn-sm" data-action="toggle-damage-ledger" data-tooltip="{{localize 'OLATTACK.Ledger.ToggleHint'}}"><i class="fa-solid {{#if damageLedger.active}}fa-pause{{else}}fa-play{{/if}}"></i> {{#if damageLedger.active}}{{localize "OLATTACK.Ledger.Pause"}}{{else}}{{localize "OLATTACK.Ledger.Activate"}}{{/if}}</button>
      <button type="button" class="ol-btn-sm" data-action="undo-damage-ledger-delete" data-tooltip="{{localize 'OLATTACK.Ledger.UndoHint'}}"><i class="fa-solid fa-rotate-left"></i> {{localize "OLATTACK.Ledger.Undo"}}</button>
      <button type="button" class="ol-btn-sm" data-action="clear-damage-ledger-applied" data-tooltip="{{localize 'OLATTACK.Ledger.CleanHint'}}"><i class="fa-solid fa-broom"></i> {{localize "OLATTACK.Ledger.Clean"}} <span class="ol-count">{{damageLedger.appliedCount}}</span></button>
      <button type="button" class="ol-btn-sm danger" data-action="clear-damage-ledger-all" data-tooltip="{{localize 'OLATTACK.Ledger.ClearHint'}}"><i class="fa-solid fa-trash"></i> {{localize "OLATTACK.Ledger.Clear"}}</button>
    </div>

    <div class="ol-ledger-list">
      {{#if damageLedger.hasLines}}
        {{#each damageLedger.lines}}
          <div class="ol-ledger-line {{statusClass}}">
            <div class="ol-ledger-amount" data-tooltip="{{amount}} {{damageTypeLabel}}"><b>{{amount}}</b><span>{{damageTypeLabel}}</span></div>
            <div class="ol-ledger-route">
              <div class="ol-ledger-names" data-tooltip="{{sourceName}} → {{targetName}}">
                <img src="{{sourceImg}}" alt=""><span>{{sourceName}}</span><i class="fa-solid fa-arrow-right"></i><img src="{{targetImg}}" alt=""><strong>{{targetName}}</strong>
              </div>
              <div class="ol-ledger-detail" data-tooltip="{{label}} {{formulaLabel}}"><span>{{label}}</span>{{#if formulaLabel}}<code>{{formulaLabel}}</code>{{/if}}</div>
            </div>
            <div class="ol-ledger-status {{statusClass}}">{{statusText}}</div>
            <div class="ol-ledger-line-actions">
              {{#if canRestore}}
                <button type="button" class="ol-icon-btn" data-action="restore-damage-ledger-line" data-line-id="{{id}}" data-tooltip="{{localize 'OLATTACK.Ledger.Restore'}}" aria-label="{{localize 'OLATTACK.Ledger.Restore'}}"><i class="fa-solid fa-rotate-left"></i></button>
              {{else}}
                <button type="button" class="ol-icon-btn primary" data-action="apply-damage-ledger-line" data-line-id="{{id}}" data-tooltip="{{localize 'OLATTACK.Ledger.ApplyLine'}}" aria-label="{{localize 'OLATTACK.Ledger.ApplyLine'}}" {{#unless canApplyLine}}disabled{{/unless}}><i class="fa-solid fa-check"></i></button>
                <button type="button" class="ol-icon-btn danger" data-action="delete-damage-ledger-line" data-line-id="{{id}}" data-tooltip="{{localize 'OLATTACK.Ledger.Delete'}}" aria-label="{{localize 'OLATTACK.Ledger.Delete'}}"><i class="fa-solid fa-xmark"></i></button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="ol-empty">{{localize "OLATTACK.Ledger.Empty"}}</p>
      {{/if}}
    </div>
  </details>

  {{#if hasScene}}
    {{#if isCombatMode}}
      <div class="ol-scene-combatbar">
        <div class="ol-btn-group">
          <button type="button" class="ol-btn-sm" data-action="configure-combat" data-tooltip="{{localize 'OLATTACK.Scene.ParticipantsHint'}}"><i class="fa-solid fa-users"></i> {{localize "OLATTACK.Scene.Participants"}}</button>
          <button type="button" class="ol-btn-sm primary" data-action="start-combat" data-tooltip="{{localize 'OLATTACK.Scene.StartHint'}}"><i class="fa-solid fa-play"></i> {{localize "OLATTACK.Scene.Start"}}</button>
          <button type="button" class="ol-btn-sm danger" data-action="end-combat" data-tooltip="{{localize 'OLATTACK.Scene.EndHint'}}"><i class="fa-solid fa-stop"></i> {{localize "OLATTACK.Scene.End"}}</button>
        </div>
        <div class="ol-btn-group">
          <button type="button" class="ol-btn-sm" data-action="roll-init-all" data-tooltip="{{localize 'OLATTACK.Scene.InitAllHint'}}"><i class="fa-solid fa-dice-d20"></i> {{localize "OLATTACK.Scene.InitAll"}}</button>
          <button type="button" class="ol-btn-sm" data-action="roll-init-npc" data-tooltip="{{localize 'OLATTACK.Scene.InitNpcHint'}}"><i class="fa-solid fa-dice-d20"></i> {{localize "OLATTACK.Scene.InitNpc"}}</button>
          <button type="button" class="ol-icon-btn" data-action="prev-turn" data-tooltip="{{localize 'OLATTACK.Scene.PrevTurn'}}" aria-label="{{localize 'OLATTACK.Scene.PrevTurn'}}"><i class="fa-solid fa-chevron-left"></i></button>
          <button type="button" class="ol-icon-btn primary" data-action="next-turn" data-tooltip="{{localize 'OLATTACK.Scene.NextTurn'}}" aria-label="{{localize 'OLATTACK.Scene.NextTurn'}}"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <div class="ol-scene-meta">
          <span class="ol-chip"><span>{{localize "OLATTACK.Scene.Conflict"}}</span> <b>{{combatMeta.selectedCount}}</b></span>
          <span class="ol-chip"><span>Ini</span> <b>{{combatMeta.rolledCount}}</b></span>
          {{#if combatMeta.pendingCount}}<span class="ol-chip is-hot"><span>{{localize "OLATTACK.Ledger.Pending"}}</span> <b>{{combatMeta.pendingCount}}</b></span>{{/if}}
        </div>
      </div>
    {{/if}}

    <div class="ol-scene-grid {{#if isCombatMode}}ol-scene-carousel {{#if isCombatVertical}}is-vertical{{else}}is-horizontal{{/if}}{{/if}}">
      {{#each rows}}
        {{> "modules/ol-attack/templates/partials/scene-card.hbs" this combat=@root.isCombatMode gm=true}}
      {{else}}
        <p class="ol-empty">{{localize "OLATTACK.Scene.NoTokens"}}</p>
      {{/each}}
    </div>
  {{else}}
    <p class="ol-empty">{{localize "OLATTACK.Scene.NoScene"}}</p>
  {{/if}}
</div>
