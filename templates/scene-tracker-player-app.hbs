<div class="ol-root ol-scene-root ol-scene-player-root {{#if isCombatVertical}}mode-combat-vertical{{else}}mode-combat-horizontal{{/if}}">
  <header class="ol-scene-header">
    <div class="ol-scene-heading" data-tooltip="{{localize 'OLATTACK.Scene.CardHintPlayer'}}">
      <h1>{{localize "OLATTACK.Scene.PlayerTitle"}}</h1>
      <span class="ol-scene-scene-name" data-tooltip="{{sceneName}}">{{sceneName}}</span>
    </div>

    <div class="ol-scene-summary">
      {{#if combatMeta.combatStarted}}<span class="ol-chip is-hot"><span>{{localize "OLATTACK.Scene.Round"}}</span> <b>{{combatMeta.combatRound}}</b></span>{{/if}}
      {{#if combatMeta.activeName}}<span class="ol-chip is-hot"><span>{{localize "OLATTACK.Scene.Turn"}}</span> <b>{{combatMeta.activeName}}</b></span>{{/if}}
      <span class="ol-chip"><span>Ini</span> <b>{{combatMeta.rolledCount}}</b></span>
      {{#if combatMeta.pendingCount}}<span class="ol-chip"><span>{{localize "OLATTACK.Ledger.Pending"}}</span> <b>{{combatMeta.pendingCount}}</b></span>{{/if}}
    </div>

    <div class="ol-scene-toolbar">
      <button type="button" class="ol-icon-btn" data-action="toggle-orientation" data-tooltip="{{localize 'OLATTACK.Scene.Orientation'}}" aria-label="{{localize 'OLATTACK.Scene.Orientation'}}"><i class="fa-solid {{#if isCombatVertical}}fa-grip{{else}}fa-grip-lines-vertical{{/if}}"></i></button>
      <button type="button" class="ol-icon-btn" data-action="refresh" data-tooltip="{{localize 'OLATTACK.Scene.Refresh'}}" aria-label="{{localize 'OLATTACK.Scene.Refresh'}}"><i class="fa-solid fa-rotate"></i></button>
    </div>
  </header>

  {{#if hasScene}}
    <div class="ol-scene-grid ol-scene-carousel {{#if isCombatVertical}}is-vertical{{else}}is-horizontal{{/if}}">
      {{#each rows}}
        {{> "modules/ol-attack/templates/partials/scene-card.hbs" this combat=true gm=false}}
      {{else}}
        <p class="ol-empty">{{localize "OLATTACK.Scene.NoTokens"}}</p>
      {{/each}}
    </div>
  {{else}}
    <p class="ol-empty">{{localize "OLATTACK.Scene.NoScene"}}</p>
  {{/if}}
</div>
